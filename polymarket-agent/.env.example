# =============================================================================
# Polymarket Agent - Variables de Entorno
# =============================================================================
# Copia este archivo como .env y completa con tus datos reales
# NUNCA subas el archivo .env a git
# =============================================================================

# --- Polymarket CLOB API ---
POLYMARKET_API_URL=https://clob.polymarket.com
POLYMARKET_PRIVATE_KEY=tu_clave_privada_aqui
POLYMARKET_API_KEY=tu_api_key_aqui
POLYMARKET_API_SECRET=tu_api_secret_aqui
POLYMARKET_API_PASSPHRASE=tu_passphrase_aqui

# --- Anthropic (Claude) API ---
ANTHROPIC_API_KEY=tu_anthropic_api_key_aqui
LLM_MODEL=claude-sonnet-4-5-20250929
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.3

# --- Telegram Bot (Monitoreo) ---
TELEGRAM_BOT_TOKEN=tu_bot_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui
TELEGRAM_ENABLED=false

# --- News API (opcional) ---
NEWS_API_KEY=tu_news_api_key_aqui

# --- Modo de operación ---
# "paper" = simulación sin dinero real | "live" = operación real
TRADING_MODE=paper

# --- Escaneo de Mercados ---
MIN_LIQUIDITY_USD=500
MIN_VOLUME_24H_USD=100
MIN_DAYS_TO_RESOLUTION=1
MAX_DAYS_TO_RESOLUTION=90
MAX_MARKETS_PER_CYCLE=20
HTTP_TIMEOUT_SECONDS=30
MIN_NEWS_COUNT=3

# --- Estrategia ---
MIN_EDGE=0.05
MIN_CONFIDENCE=medium
KELLY_FRACTION=0.25

# --- Gestión de Riesgo ---
MAX_BANKROLL_USD=500
MAX_PER_TRADE_PCT=0.05
MAX_PER_MARKET_PCT=0.10
MAX_PER_CATEGORY_PCT=0.25
MAX_EXPOSURE_PCT=0.60
MAX_DAILY_LOSS_PCT=0.10
MAX_WEEKLY_LOSS_PCT=0.15
MAX_DRAWDOWN_PCT=0.25
COOLDOWN_HOURS=6
STOP_LOSS_PCT=0.15

# --- Ejecución ---
ORDER_TYPE=limit
SLIPPAGE_TOLERANCE=0.02
ORDER_TIMEOUT_MINUTES=15
MAX_PRICE_DEVIATION=0.03

# --- Agente ---
SCAN_INTERVAL_MINUTES=30
DAILY_REPORT_HOUR=21
DASHBOARD_PORT=8501

# --- Base de datos ---
DATABASE_PATH=data/portfolio.db

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log
